generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
  schemas = ["mowe_lms"]
}
enum Role {
  STUDENT
  ADMIN
  SUPERADMIN
  @@schema("mowe_lms")
}
enum ChallengePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  @@schema("mowe_lms")
}
model User {
  id String @id @default(cuid())
  email String @unique
  studentNumber String? @unique
  name String
  role Role @default(STUDENT)
  passwordHash String
  emailVerifiedAt DateTime?
  passwordChangedAt DateTime?
  suspendedAt DateTime?
  suspensionReason String @default("")
  suspendedById String?
  bio String @default("")
  linkedinUrl String @default("")
  photoUrl String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  challenges AuthChallenge[]
  learning LearningRecord[]
  quizAttempts QuizAttempt[]
  assets FileAsset[]
  @@schema("mowe_lms")
  @@map("lms_auth_users")
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
  @@schema("mowe_lms")
  @@map("lms_auth_sessions")
}
model AuthChallenge {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  purpose ChallengePurpose
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  sentAt DateTime @default(now())
  @@unique([userId,purpose])
  @@index([expiresAt])
  @@schema("mowe_lms")
  @@map("lms_auth_challenges")
}
model AdminInvitation {
  id String @id @default(cuid())
  tokenHash String @unique
  email String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([email])
  @@index([expiresAt])
  @@schema("mowe_lms")
  @@map("lms_auth_invitations")
}
model AuthRateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
  @@schema("mowe_lms")
  @@map("lms_auth_rate_limits")
}

// The course is an ordered authoring document. Its complete validated snapshot
// is stored with each version, so edits and in-flight quizzes remain consistent.
model Course {
  id String @id
  title String
  status String
  position Int
  version Int @default(1)
  document Json
  deletedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([status, position])
  @@schema("mowe_lms")
  @@map("lms_courses")
}
model CourseVersion {
  id String @id @default(cuid())
  courseId String
  document Json
  createdAt DateTime @default(now())
  @@index([courseId, createdAt])
  @@schema("mowe_lms")
  @@map("lms_course_versions")
}
model LearningRecord {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  kind String
  key String
  document Json
  updatedAt DateTime @updatedAt
  @@unique([userId, kind, key])
  @@index([kind])
  @@schema("mowe_lms")
  @@map("lms_learning_records")
}
model QuizAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  courseId String
  assessment Json
  answers Json?
  feedback Json?
  score Int @default(-1)
  status String @default("started")
  startedAt DateTime @default(now())
  submittedAt DateTime?
  @@index([userId, courseId])
  @@schema("mowe_lms")
  @@map("lms_quiz_attempts")
}
model AcademySetting {
  id String @id @default("program")
  document Json
  @@schema("mowe_lms")
  @@map("lms_academy_settings")
}
model FileAsset {
  id String @id @default(uuid())
  ownerId String?
  owner User? @relation(fields:[ownerId],references:[id],onDelete:SetNull)
  publicId String @unique
  resourceType String
  deliveryType String
  format String @default("")
  secureUrl String
  name String
  mime String
  size Int
  purpose String
  courseId String?
  createdAt DateTime @default(now())
  @@index([ownerId, purpose])
  @@index([purpose, createdAt])
  @@schema("mowe_lms")
  @@map("lms_file_assets")
}
