{
  "name": "mowe-academy-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/cli/seed-courses.ts",
    "db:migrate": "prisma migrate deploy",
    "admin:invite": "tsx src/cli/invite-admin.ts",
    "auth:cleanup": "tsx src/cli/cleanup.ts",
    "smtp:verify": "tsx src/cli/verify-smtp.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
